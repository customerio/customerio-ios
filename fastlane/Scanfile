# scheme for xcodebuild
# name found by running: `xcrun xcodebuild -list` (or, see output of workflow run)
scheme("Customer.io-Package")

# -destination for xcodebuild
# Device and OS are both pinned: when a destination does not resolve, fastlane logs
# "couldn't find matching simulator" and quietly falls back to another one, making the tested
# OS an accident of the runner image. This pin must match the iOS runtime shipped by the CI
# image. The `xcode-27` image (macOS 27, Xcode 27) preinstalls the iOS 27.0 runtime with an
# "iPhone 17" device, so this resolves there. It depends on CI selecting the Xcode 27 image
# (see test.yml -> mobile-ci-tools ios-test.yml). Change one, check the other.
devices([
  "iPhone 17 (27.0)"
])

output_types("html,junit")
output_files("test-report.html,test-report.xml")
output_directory(".")

code_coverage(true)
result_bundle(true) # required to get code coverage report 
derived_data_path(".build/derivedData")

skip_build(true) # speed up testing 

package_path("./")